          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Seique'l sitiu tea temporalmente non disponible o mui ocupáu. Volvi tentalo nun momentu.\n• Si nun yes a cargar nenguna páxina, comprueba la conexón Wi-Fi o móvil del preséu."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
