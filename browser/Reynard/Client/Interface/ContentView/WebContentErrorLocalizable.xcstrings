        },
        "hi-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़र दिए गए एड्रेस के लिए होस्ट सर्वर नहीं ढूंढ पाया।\n• देखें कि एड्रेस में टाइपिंग की गड़बड़ी तो नहीं है। जैसे कि, www.example.com के बजाय ww.example.com लिखा गया हो।\n• अगर कोई भी पेज लोड नहीं हो पा रहा है, तो अपने डिवाइस का डेटा या वाई-फ़ाई कनेक्शन देख लें।"
          }
        },
