    "Try connecting on a different device. Check your modem or router. Disconnect and reconnect to Wi-Fi." : {
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሌላ መሣሪያ ላይ ለመገናኘት ይሞክሩ። የእርስዎን ሞደም ወይም ራውተር ይፈትሹ። ግንኙነቱን ያቋርጡ እና ከWi-Fi ጋር እንደገና ያገናኙ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول الاتصال من جهاز آخر. تحقّق من المودم أو جهاز التوجيه. افصل اتصالك بالواي فاي وأعد الاتصال به."
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenta de conectate a otru preséu. Comprueba'l módem o router. Desconéctate de la Wi-Fi y volvi conectate a ella."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паспрабуйце падлучыцца на іншай прыладзе. Праверце мадэм або маршрутызатар. Адключыцеся і паўторна падключыцеся да Wi-Fi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опитайте да се свържете от друго устройство. Проверете модема или рутера. Изключете и се свържете отново с безжичната мрежа."
          }
        },
        "bqi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قپ ریت کۊنین وا دسگا دیری منپیز بۊین. مودم یا رۊتر خوتووݩ ن واجۊری کۊنین. منپیز ن قت کۊنین وو دووارته و Wi-Fi منپیز بۊین."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaskit kennaskañ war un trevnad all. Gwiriekait ho modem pe ho heñcher. Digennaskit hag adkennaskit ouzh ar wifi."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušajte se povezati na drugom uređaju. Provjerite svoj modem ili ruter. Prekinite vezu i ponovo se povežite na Wi-Fi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proveu de connectar-vos en un altre dispositiu. Reviseu el mòdem o l’encaminador. Desconnecteu-vos de la Wi-Fi i torneu-vos-hi a connectar."
          }
        },
        "cak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatojtob'ej yatok chik pa jun okisaxel. Tanik'oj ri amodem o router. Tachupu' chuqa' katok chik pa WiFi."
          }
        },
        "co" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruvate di cunnettevi nant’à un altru apparechju. Verificate u vostru modem o « router ». Discunnittitevi è ricunnittitevi à u Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste se připojit na jiném zařízení. Zkontrolujte modem nebo router. Odpojte se a znovu se připojte k Wi-Fi."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceisiwch gysylltu ar ddyfais wahanol. Gwiriwch eich modem neu lwybrydd. Datgysylltwch ac ailgysylltwch â'r Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at oprette forbindelse med en anden enhed. Kontroller dit modem eller din router. Afbryd wi-fi-forbindelsen og opret den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie, auf einem anderen Gerät eine Verbindung herzustellen. Überprüfen Sie Ihr Modem oder Router. Trennen Sie die WLAN-Verbindung und stellen Sie die Verbindung wieder her."
          }
        },
        "dsb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wopytajśo z drugim rědom zwězaś. Pśeglědajśo swój modem abo router. Źělśo zwisk WLAN a zwěžćo znowego."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε να συνδεθείτε από διαφορετική συσκευή. Ελέγξτε το modem ή το router σας. Αποσυνδέστε και επανασυνδέστε το Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try connecting on a different device. Check your modem or router. Disconnect and reconnect to Wi-Fi."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try connecting on a different device. Check your modem or router. Disconnect and reconnect to Wi-Fi."
