        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proovi ühendada mõnes muus seadmes. Kontrolli oma modemit või ruuterit. Katkesta ühendus ja ühenda uuesti Wi-Fi-ga."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiatu beste gailu batekin konektatzen. Egiaztatu zure modem edo routerra. Deskonektatu eta konektatu berriro Wi-Fi sarera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سعی کنید با دستگاه دیگری متصل شوید. مودم یا روتر خود را بررسی کنید. اتصال را قطع کرده و دوباره به Wi-Fi متصل شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritä muodostaa yhteys toisella laitteella. Tarkista modeemi tai reititin. Katkaise Wi-Fi-yhteys ja yhdistä se uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subukang kumonekta gamit ang ibang device. I-check mo ang iyong modem o router. Mag-disconnect at mag-reconnect sa Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de vous connecter sur un autre appareil. Vérifiez votre modem ou votre routeur. Déconnectez-vous puis reconnectez-vous au Wi-Fi."
          }
        },
        "fur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prove a colegâti suntun altri dispositîf, controle il modem o il router. Disconet e torne a coneti il dispositîf al Wi-Fi."
          }
        },
        "fy-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probearje ferbining te meitsjen op in oar apparaat. Kontrolearje jo modem of router. Ferbrek jo wififerbining en meitsje opnij ferbining."
          }
        },
        "ga-IE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bain triail as ceangal a dhéanamh ar ghléas eile. Seiceáil do mhóideam nó do ródaire. Dícheangail agus athcheangail le Wi-Fi."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feuch is dèan ceangal air uidheam eile. Thoir sùil air a’ mhòdam no rùtar agad. Dì-cheangail on WiFi is ceangail ris as ùr."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proba a conectar cun dispositivo diferente. Comproba o teu módem ou router. Desconecta e volve conectar á wifi."
          }
        },
        "gn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eñeha’ã eike ambue mba’e’okápe. Ehechajey ne módem térã router-pe. Esẽa ha upéi eikejey Wi-Fi rupive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נא לנסות להתחבר במכשיר אחר, לבדוק את המודם או הנתב שלך, ולהתנתק ולהתחבר מחדש ל־Wi-Fi."
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी दूसरे डिवाइस से कनेक्ट करने की कोशिश करें। अपना मॉडेम या राउटर चेक करें। वाई-फ़ाई से डिस्कनेक्ट करके फिर से कनेक्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušaj se povezati na jednom drugom uređaju. Provjeri modem ili router. Prekini vezu i ponovo se spoji na Wi-Fi."
          }
        },
        "hsb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spytajće z druhim gratom zwjazać. Přepruwujće swój modem abo router. Dźělće zwisk WLAN a zwjazajće znowa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbáljon meg csatlakozni egy másik eszközről. Ellenőrizze a modemet vagy útválasztót. Bontsa a kapcsolatot, majd csatlakozzon újra a Wi-Fi-hez."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փորձեք միանալ մեկ այլ սարքի: Ստուգեք ձեր մոդեմը կամ երթուղիչը: Կապախզեք և նորից միացեք Wi-Fi-ին:"
          }
        },
        "ia" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a connecter te ab un altere apparato. Controla le modem o le router. Disactiva e reactiva le connexion Wi-Fi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobalah menyambung di perangkat lain. Periksa modem atau router Anda. Putuskan dan sambungkan kembali ke Wi-Fi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prófaðu að tengjast í öðru tæki. Athugaðu mótaldið þitt eða beininn. Aftengdu og tengdu aftur við Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a connetterti da un altro dispositivo, controlla il modem o il router, disattiva e riattiva la connessione Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の端末で接続してみてください。モデムまたはルーターを確認してください。Wi-Fi を一旦切断して再接続してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სცადეთ დაკავშირება სხვა მოწყობილობიდან. შეამოწმეთ თქვენი მოდემი ან როუტერი. გამოთიშეთ და კვლავ დაუკავშირეთ WiFi."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ԑreḍ ad teqqneḍ ɣef yibenk niḍen. Senqed amudam-ik. Sens syen ales tuqqna ɣer Wi-Fi."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Басқа құрылғыда байланысып көріңіз. Модемді немесе маршрутизаторды тексеріңіз. Wi-Fi желісіне байланысты ажыратып, оған қайта қосылыңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សាកល្បងភ្ជាប់នៅលើឧបករណ៍ផ្សេង។ ពិនិត្យមើលម៉ូដឹម ឬរ៉ោតទ័ររបស់អ្នក។ ផ្តាច់ ហើយភ្ជាប់ទៅ Wi-Fi ឡើងវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 연결해 보세요. 모뎀이나 라우터를 확인하세요. Wi-Fi 연결을 끊었다가 다시 연결하세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewlê bide bi cîhazeke din girêdanê çêkî. Modem yan routera xwe kontrol bike. Girêdana Wi-Fiyê qut bike û girêdanê dîsa çêke."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ລອງເຊື່ອມຕໍ່ໃນອຸປະກອນອື່ນ. ກວດເບິ່ງໂມເດັມ ຫຼື ເຣົາເຕີຂອງທ່ານ. ຕັດການເຊື່ອມຕໍ່ ແລະ ເຊື່ອມຕໍ່ Wi-Fi ຄືນໃໝ່."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pabandykite prisijungti naudodami kitą įrenginį. Patikrinkite modemą arba maršrutizatorių. Atsijunkite bei vėl prisijunkite prie Wi-Fi."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മറ്റൊരു ഉപകരണത്തോറു ബന്ധപ്പെടാൻ ശ്രമിക്കുക. താങ്ങളുടെ മോഡം പരിശോധിക്കുക. വൈഫൈ-ലേക്കു് വിച്ഛേതിച്ചും വീണ്ടും ബന്ധപ്പെടിയിട്ടു് ശ്രമിക്കുക"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å koble til på en annen enhet. Sjekk modemet eller ruteren. Koble fra og koble til Wi-Fi igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer verbinding te maken op een ander apparaat. Controleer uw modem of router. Verbreek uw wifiverbinding en maak opnieuw verbinding."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å kople til på ei anna eining. Sjekk modemet eller ruteren. Kople frå og kople til Wi-fi igjen."
          }
        },
        "oc" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensajatz de vos connectar sus un autre aparelh. Verificatz vòstre modèm o rotador. Desconnectatz-vos puèi reconnectatz-vos al Wi-Fi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshaa adda ta'e irratti wal qunnamsiisuuf yaali. Modem ykn router kee ilaali. Wi-Fi irraa addaan kutuun deebisii wal qunnamsiisi."
          }
        },
        "pa-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਖਰੇ ਡਿਵਾਈਸ ਨਾਲ ਕਨੈਕਟ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ। ਆਪਣੇ ਮਾਡਮ ਜਾਂ ਰਾਊਟਰ ਦੀ ਜਾਂਚ ਕਰੋ। Wi-Fi ਤੋਂ ਡਿਸ-ਕਨੈਕਟ ਕਰਕੇ ਫੇਰ ਕਨੈਕਟ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj połączyć się na innym urządzeniu. Sprawdź modem lub router. Rozłącz się i ponownie połącz z siecią Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente se conectar usando outro dispositivo. Verifique seu modem ou roteador. Desconecte e reconecte ao WiFi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente ligar-se num dispositivo diferente. Verifique o seu modem ou router. Desligue-se e volte a ligar-se ao Wi-Fi."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emprova da ta connectar cun in auter apparat. Controllescha tes modem u router. Deconnectescha e reconnectescha il WLAN."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încearcă să te conectezi pe un alt dispozitiv. Verifică modemul sau routerul. Deconectează-te și reconectează-te la Wi-Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте подключиться на другом устройстве. Проверьте ваш модем или маршрутизатор. Отключитесь и снова подключитесь к Wi-Fi."
          }
        },
        "sat" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ᱮᱴᱟᱜ ᱥᱟᱫᱷᱚᱱ ᱨᱮ ᱡᱚᱯᱲᱟᱣ ᱨᱮᱭᱟᱜ ᱠᱩᱨᱩᱢᱩᱴᱩᱭ ᱢᱮ ᱾ ᱟᱢᱟᱜ ᱢᱚᱰᱮᱢ ᱵᱟᱝᱠᱷᱟᱱ ᱨᱟᱣᱴᱚᱨ ᱧᱮᱞ ᱵᱤᱰᱟᱹᱣ ᱢᱮ ᱾ Wi-Fi ᱥᱟᱶ ᱡᱚᱯᱲᱟᱣ ᱜᱮᱫ ᱠᱟᱛᱮ ᱟᱨ ᱫᱚᱦᱲᱟ ᱡᱚᱯᱲᱟᱣ ᱢᱮ ᱾"
          }
        },
        "sc" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a ti connètere dae unu dispositivu diferente. Controlla su modem o su router tuo. Disconnete·ti e torra·ti a connètere a su Wi-Fi."
          }
        },
        "scn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a cullijàriti di n’autru dispusitivu. Cuntrolla u modem o u router. Scullèjati e cullèjati arrè ô Wi-Fi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skúste sa pripojiť na inom zariadení. Skontrolujte modem alebo smerovač. Odpojte sa a znova sa pripojte k sieti Wi-Fi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskusite se povezati z drugo napravo. Preverite modem ali usmerjevalnik. Odklopite in ponovno povežite Wi-Fi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provoni të lidheni që nga një pajisje tjetër. Shihni modemin ose rrugëzuesin tuaj. Shkëputuni dhe rilidhuni me Wi-Fi-n."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покушајте се повезати са другог уређаја. Проверите ваш модем или рутем. Прекините везу и поново се повежите на Wi-Fi."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova att ansluta på en annan enhet. Kontrollera ditt modem eller router. Koppla ner och återanslut till Wi-Fi."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кӯшиш кунед, ки дар дастгоҳи дигар пайваст шавед. Модем ё роутери худро тафтиш кунед. Пайвастшавии «Wi-Fi»-ро қатъ карда, аз нав пайваст шавед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเชื่อมต่อบนอุปกรณ์อื่น ตรวจสอบโมเด็มหรือเราเตอร์ของคุณ ตัดการเชื่อมต่อและเชื่อมต่อกับ Wi-Fi อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı bir cihazdan bağlanmayı deneyin. Modeminizi veya yönlendiricinizi kontrol edin. Wi-Fi bağlantınızı kesip yeniden bağlanın."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باشقا ئۈسكۈنىگە باغلاپ سىناپ بېقىڭ. مودېمىڭىز ياكى يېتەكلىگۈچىڭىزنى تەكشۈرۈڭ. باغلىنىشنى ئۈزۈپ ئاندىن سىمسىز تور يەنى Wi-Fi غا قايتا باغلاڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте під’єднатися на іншому пристрої. Перевірте свій модем або маршрутизатор. Від’єднайтеся і знову під’єднайтеся до Wi-Fi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử kết nối trên thiết bị khác. Kiểm tra modem hoặc bộ định tuyến của bạn. Ngắt kết nối và kết nối lại với Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请尝试通过其他设备连接、检查调制解调器或路由器、断开 Wi-Fi 连接后重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以試著連線到其他裝置、檢查您的數據機或路由器，或將 Wi-Fi 斷線重連。"
          }
        }
      }
