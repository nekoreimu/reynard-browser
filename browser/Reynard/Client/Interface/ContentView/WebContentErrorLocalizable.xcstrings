        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gant ar chomlecʼh goulennet ez eus bet erspizet ur porzh (d.l.e. mozilla.org:80 evit ar porzh 80 war mozilla.org) arveret dre voaz evit palioù all eget ar merdeiñ war internet. Dilezet eo bet an azgoulenn gant ar merdeer evit ho kwarez hag ho tiogelroez."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatražena adresa ima definiran priključak (npr. mozilla.org:80 za priključak 80 na mozilla.org) koji se inače koristi za druge radnje, a ne za pregledavanje weba. Browser je prekinuo zahtjev radi tvoje zaštite i sigurnosti."
          }
