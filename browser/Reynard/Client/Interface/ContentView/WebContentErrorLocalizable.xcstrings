        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Էջը, որը դուք փորձում էք դիտել, չի կարող ցուցադրվել, քանի որ այն օգտագործում է սխալ կամ չսպասարկվող խտացման ձև:\n• Կապնվեք կայքի սեփականատերերի հետ և տեղյակ պահեք նրանց խնդրի մասին:"
          }
