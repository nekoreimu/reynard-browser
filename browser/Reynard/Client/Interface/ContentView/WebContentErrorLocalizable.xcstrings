        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դիտարկիչը չկարողացավ գտնել տրամադրված հասցեի հոսթի սպասարկիչը:\n• Ստուգեք հասցեն՝ մուտքագրման սխալների համար, ինչպիսիք են՝ ww.example.com՝ www.example.com-ի փոխարեն\n• Եթե որևէ էջ չի բեռնվում, ապա ստուգեք ձեր սարքի տվյալները կամ Wi-Fi կապակցումը:"
