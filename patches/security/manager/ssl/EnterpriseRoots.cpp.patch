diff --git a/security/manager/ssl/EnterpriseRoots.cpp b/security/manager/ssl/EnterpriseRoots.cpp
--- a/security/manager/ssl/EnterpriseRoots.cpp
+++ b/security/manager/ssl/EnterpriseRoots.cpp
@@ -21,6 +21,9 @@

 #  include "KeychainSecret.h"
 #endif
+#ifdef XP_IOS
+#  include <Security/Security.h>
+#endif  // XP_IOS

 #ifdef XP_WIN
 #  include <wincrypt.h>
@@ -464,6 +464,82 @@
   return errSecSuccess;
 }
 #endif  // XP_MACOSX
+#ifdef XP_IOS
+// iOS apps cannot read the system keychain directly, so unlike macOS we
+// cannot enumerate keychain certificates. Instead, build a (non-evaluated)
+// SecTrust object for the TLS server policy and copy its anchor set, which
+// contains the system anchors plus any user- or MDM-installed trusted CAs
+// (e.g. a proxy/MITM CA the user trusted in Settings). Certificates that
+// already ship with NSS are filtered out via IsKnownRoot, same as the other
+// platforms. Note: per-certificate distrust settings are not consulted here;
+// explicitly distrusted built-in roots are still skipped because they are
+// known roots.
+static void GatherEnterpriseCertsIOS(nsTArray<EnterpriseCert>& certs,
+                                     UniqueSECMODModule& rootsModule) {
+  SecPolicyRef policy = SecPolicyCreateSSL(true, nullptr);
+  if (!policy) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Debug, ("failed to create SSL SecPolicy"));
+    return;
+  }
+
+  // An empty certificate list is sufficient: creating the trust object does
+  // not validate anything, and the anchor set depends only on the policy.
+  CFArrayRef emptyCerts =
+      CFArrayCreate(nullptr, nullptr, 0, &kCFTypeArrayCallBacks);
+  if (!emptyCerts) {
+    CFRelease(policy);
+    return;
+  }
+  SecTrustRef trust = nullptr;
+  OSStatus status = SecTrustCreateWithCertificates(emptyCerts, policy, &trust);
+  CFRelease(emptyCerts);
+  CFRelease(policy);
+  if (status != errSecSuccess || !trust) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+            ("failed to create SecTrust (%d)", (int)status));
+    return;
+  }
+
+  CFArrayRef anchors = SecTrustCopyAnchorCertificates(trust);
+  CFRelease(trust);
+  if (!anchors) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+            ("failed to copy anchor certificates"));
+    return;
+  }
+  uint32_t numImported = 0;
+  CFIndex count = CFArrayGetCount(anchors);
+  for (CFIndex i = 0; i < count; i++) {
+    SecCertificateRef certificate =
+        (SecCertificateRef)CFArrayGetValueAtIndex(anchors, i);
+    if (!certificate ||
+        CFGetTypeID(certificate) != SecCertificateGetTypeID()) {
+      continue;
+    }
+    CFDataRef der = SecCertificateCopyData(certificate);
+    if (!der) {
+      MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+              ("couldn't get bytes of certificate?"));
+      continue;
+    }
+    // Anchors are trust roots by definition (cf. Android, which treats all
+    // certificates gleaned from the OS CA store as roots).
+    EnterpriseCert enterpriseCert(CFDataGetBytePtr(der), CFDataGetLength(der),
+                                  /*isRoot=*/true);
+    CFRelease(der);
+    // Skip certificates that already ship with NSS; this keeps the list small
+    // (in practice only user-/MDM-added CAs remain).
+    if (!enterpriseCert.IsKnownRoot(rootsModule)) {
+      certs.AppendElement(std::move(enterpriseCert));
+      numImported++;
+    } else {
+      MOZ_LOG(gPIPNSSLog, LogLevel::Debug, ("skipping known root cert"));
+    }
+  }
+  CFRelease(anchors);
+  MOZ_LOG(gPIPNSSLog, LogLevel::Debug, ("imported %u certs", numImported));
+}
+#endif  // XP_IOS

 #ifdef MOZ_WIDGET_ANDROID
 void GatherEnterpriseCertsAndroid(nsTArray<EnterpriseCert>& certs,
@@ -515,5 +515,8 @@
 #ifdef MOZ_WIDGET_ANDROID
   GatherEnterpriseCertsAndroid(certs, rootsModule);
 #endif  // MOZ_WIDGET_ANDROID
+#ifdef XP_IOS
+  GatherEnterpriseCertsIOS(certs, rootsModule);
+#endif  // XP_IOS
   return NS_OK;
 }
