+#ifdef XP_IOS
+// Asks the iOS system trust store whether it trusts the given peer chain
+// for TLS server authentication. If it does, imports the anchor certificate
+// that completed the chain as an enterprise trust root and returns true so
+// verification can be retried. Returns false (leaving everything untouched)
+// on any failure.
+static bool ImportIOSPlatformAnchorAsEnterpriseRoot(
+    const nsACString& aHostName,
+    const nsTArray<nsTArray<uint8_t>>& aPeerCerts) {
+  if (aPeerCerts.IsEmpty()) {
+    return false;
+  }
+  // Convert the peer chain to SecCertificateRefs.
+  CFMutableArrayRef certArray = CFArrayCreateMutable(
+      nullptr, aPeerCerts.Length(), &kCFTypeArrayCallBacks);
+  if (!certArray) {
+    return false;
+  }
+  for (const auto& certBytes : aPeerCerts) {
+    if (certBytes.IsEmpty()) {
+      continue;
+    }
+    CFDataRef der = CFDataCreate(nullptr, certBytes.Elements(),
+                                 certBytes.Length());
+    if (!der) {
+      continue;
+    }
+    SecCertificateRef certificate = SecCertificateCreateWithData(nullptr, der);
+    CFRelease(der);
+    if (!certificate) {
+      continue;
+    }
+    CFArrayAppendValue(certArray, certificate);
+    CFRelease(certificate);
+  }
+  if (CFArrayGetCount(certArray) == 0) {
+    CFRelease(certArray);
+    return false;
+  }
+  bool imported = false;
+  CFStringRef hostName = CFStringCreateWithBytes(
+      nullptr, reinterpret_cast<const UInt8*>(aHostName.BeginReading()),
+      aHostName.Length(), kCFStringEncodingUTF8, false);
+  SecPolicyRef policy = hostName ? SecPolicyCreateSSL(true, hostName) : nullptr;
+  SecTrustRef trust = nullptr;
+  if (policy && SecTrustCreateWithCertificates(certArray, policy, &trust) ==
+                    errSecSuccess &&
+      trust) {
+    CFErrorRef trustError = nullptr;
+    if (SecTrustEvaluateWithError(trust, &trustError)) {
+      // The platform trusts this chain. Import the anchor that completed it
+      // (the last certificate) as an enterprise root.
+      CFIndex chainLength = SecTrustGetCertificateCount(trust);
+      if (chainLength > 0) {
+        SecCertificateRef anchor =
+            SecTrustGetCertificateAtIndex(trust, chainLength - 1);
+        CFDataRef anchorDER =
+            anchor ? SecCertificateCopyData(anchor) : nullptr;
+        if (anchorDER) {
+          nsAutoCString anchorDERBytes(
+              reinterpret_cast<const char*>(CFDataGetBytePtr(anchorDER)),
+              CFDataGetLength(anchorDER));
+          CFRelease(anchorDER);
+          nsCOMPtr<nsINSSComponent> nssComponent =
+              do_GetService("@mozilla.org/psm;1");
+          if (nssComponent &&
+              NS_SUCCEEDED(nssComponent->AddEnterpriseRoot(anchorDERBytes))) {
+            MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+                    ("imported iOS platform anchor as enterprise root"));
+            imported = true;
+          }
+        }
+      }
+    } else if (trustError) {
+      CFRelease(trustError);
+    }
+  }
+  if (trust) {
+    CFRelease(trust);
+  }
+  if (policy) {
+    CFRelease(policy);
+  }
+  if (hostName) {
+    CFRelease(hostName);
+  }
+  CFRelease(certArray);
+  return imported;
+}
+#endif  // XP_IOS
