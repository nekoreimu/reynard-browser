+void ApplyInitialState(Gamepad* aGamepad, const GamepadState& aState) {
+  for (const auto& button : aState.buttons()) {
+    aGamepad->SetButton(button.button(), button.pressed(), button.touched(),
+                        button.value());
+  }
+  for (const auto& axis : aState.axes()) {
+    aGamepad->SetAxis(axis.axis(), axis.value());
+  }
+  for (uint32_t i = 0; i < aState.touches().Length(); ++i) {
+    aGamepad->SetTouchEvent(i, aState.touches()[i]);
+  }
+  aGamepad->SetPose(aState.pose());
+}
+
+nsGlobalWindowInner* OutputWindow(nsIGlobalObject* aGlobal) {
+  auto* window = nsGlobalWindowInner::Cast(aGlobal->GetAsInnerWindow());
+  Document* document = window ? window->GetExtantDoc() : nullptr;
+  if (!document || !document->IsFullyActive()) {
+    return nullptr;
+  }
+  if (document->Hidden() || window->GetOuterWindow()->IsBackground()) {
+    return nullptr;
+  }
+  return window;
+}
+
 }  // namespace
 
