@@ -1337,3 +1337,45 @@
 }
 
 main();
+// English fallback strings for the certificate error page, used when Fluent
+// localization resources are unavailable. Keys mirror data-l10n-id values;
+// {hostname} is replaced with the failed hostname. Fluent translations, when
+// available, overwrite these via the normal data-l10n-id mechanism.
+const ENGLISH_FALLBACK_STRINGS = {
+  "neterror-page-title": "Problem loading page",
+  "certerror-page-title": "Warning: Potential Security Risk Ahead",
+  "certerror-sts-page-title": "Did Not Connect: Potential Security Issue",
+  "nssBadCert-title": "Warning: Potential Security Risk Ahead",
+  "nssBadCert-sts-title": "Did Not Connect: Potential Security Issue",
+  "certerror-intro":
+    "Firefox detected a potential security threat and did not continue to " +
+    "{hostname}. If you visit this site, attackers could try to steal " +
+    "information like your passwords, emails, or credit card details.",
+  "certerror-sts-intro":
+    "Firefox detected a potential security threat and did not continue to " +
+    "{hostname} because this website requires a secure connection.",
+  "neterror-advanced-button": "Advanced\u2026",
+  "neterror-return-to-previous-page-button": "Go Back",
+  "neterror-return-to-previous-page-recommended-button": "Go Back (Recommended)",
+  "neterror-override-exception-button": "Accept the Risk and Continue",
+  "neterror-view-certificate-link": "View Certificate",
+  "neterror-learn-more-link": "Learn more\u2026",
+  "neterror-try-again-button-2": "Try Again",
+  "neterror-copy-to-clipboard-button": "Copy text to clipboard",
+};
+// Fill every localizable element Fluent left empty with built-in English.
+// Safe to call unconditionally: elements already translated are skipped,
+// and later Fluent updates overwrite these values normally.
+function applyEnglishFallbackStrings() {
+  for (const element of document.querySelectorAll("[data-l10n-id]")) {
+    const l10nId = element.getAttribute("data-l10n-id");
+    let text = ENGLISH_FALLBACK_STRINGS[l10nId];
+    if (text === undefined || element.textContent.trim() !== "") {
+      continue;
+    }
+    if (typeof HOST_NAME === "string" && HOST_NAME) {
+      text = text.split("{hostname}").join(HOST_NAME);
+    }
+    element.textContent = text;
+  }
+}
