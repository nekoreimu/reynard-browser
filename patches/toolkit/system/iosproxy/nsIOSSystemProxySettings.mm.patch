+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetProxyForURI(const nsACString& aSpec,
+                                         const nsACString& aScheme,
+                                         const nsACString& aHost, int32_t aPort,
+                                         nsACString& aResult) {
+  aResult.Truncate();
+
+  @autoreleasepool {
+    auto settings = CFTypeRefPtr<CFDictionaryRef>::WrapUnderCreateRule(
+        CFNetworkCopySystemProxySettings());
+    if (!settings) {
+      aResult.AssignLiteral("DIRECT");
+      return NS_OK;
+    }
+
+    NSString* spec =
+        [NSString stringWithUTF8String:PromiseFlatCString(aSpec).get()];
+    NSURLComponents* components = [NSURLComponents componentsWithString:spec];
+    components.scheme =
+        [NSString stringWithUTF8String:PromiseFlatCString(aScheme).get()];
+    NSURL* url = components.URL;
+    if (!url) {
+      return NS_ERROR_FAILURE;
+    }
+
+    auto systemProxies = CFTypeRefPtr<CFArrayRef>::WrapUnderCreateRule(
+        CFNetworkCopyProxiesForURL((CFURLRef)url, settings.get()));
+    NSMutableArray* proxies = [NSMutableArray array];
+    for (NSDictionary* proxy in (NSArray*)systemProxies.get()) {
+      NSString* type = proxy[(NSString*)kCFProxyTypeKey];
+      if ([type isEqual:(NSString*)kCFProxyTypeAutoConfigurationURL] ||
+          [type isEqual:(NSString*)kCFProxyTypeAutoConfigurationJavaScript]) {
+        auto resolved = ResolveAutoConfigProxy(proxy, url);
+        if (resolved) {
+          [proxies addObjectsFromArray:(NSArray*)resolved.get()];
+        }
+      } else {
+        [proxies addObject:proxy];
+      }
+    }
+
+    for (NSDictionary* proxy in proxies) {
+      NSString* type = proxy[(NSString*)kCFProxyTypeKey];
+      const char* proxyType;
+      if ([type isEqual:(NSString*)kCFProxyTypeNone]) {
+        if (!aResult.IsEmpty()) {
+          aResult.AppendLiteral("; ");
+        }
+        aResult.AppendLiteral("DIRECT");
+        continue;
+      }
+
+      if ([type isEqual:(NSString*)kCFProxyTypeHTTP] ||
+          [type isEqual:(NSString*)kCFProxyTypeHTTPS]) {
+        proxyType = "PROXY";
+      } else if ([type isEqual:(NSString*)kCFProxyTypeSOCKS]) {
+        proxyType = "SOCKS5";
+      } else {
+        return NS_ERROR_FAILURE;
+      }
+
+      NSString* host = proxy[(NSString*)kCFProxyHostNameKey];
+      NSNumber* port = proxy[(NSString*)kCFProxyPortNumberKey];
+      bool ipv6 = [host rangeOfString:@":"].location != NSNotFound;
+      if (!aResult.IsEmpty()) {
+        aResult.AppendLiteral("; ");
+      }
+      aResult.AppendPrintf("%s %s%s%s:%d", proxyType, ipv6 ? "[" : "",
+                           host.UTF8String, ipv6 ? "]" : "", port.intValue);
+    }
+  }
+
+  return aResult.IsEmpty() ? NS_ERROR_FAILURE : NS_OK;
+}
