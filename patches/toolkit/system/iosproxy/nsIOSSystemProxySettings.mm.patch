+static CFTypeRefPtr<CFArrayRef> ResolveAutoConfigProxy(NSDictionary* aProxy,
+                                                       NSURL* aURL) {
+  CFTypeRefPtr<CFArrayRef> result;
+  CFStreamClientContext context = {0, &result, nullptr, nullptr, nullptr};
+  auto callback = [](void* aContext, CFArrayRef aProxies, CFErrorRef aError) {
+    if (aProxies && !aError) {
+      static_cast<CFTypeRefPtr<CFArrayRef>*>(aContext)->AssignUnderGetRule(
+          aProxies);
+    }
+
+    CFRunLoopStop(CFRunLoopGetCurrent());
+  };
+
+  CFRunLoopSourceRef source;
+  if ([aProxy[(NSString*)kCFProxyTypeKey]
+          isEqual:(NSString*)kCFProxyTypeAutoConfigurationURL]) {
+    source = CFNetworkExecuteProxyAutoConfigurationURL(
+        (CFURLRef)aProxy[(NSString*)kCFProxyAutoConfigurationURLKey],
+        (CFURLRef)aURL, callback, &context);
+  } else {
+    source = CFNetworkExecuteProxyAutoConfigurationScript(
+        (CFStringRef)aProxy[(NSString*)kCFProxyAutoConfigurationJavaScriptKey],
+        (CFURLRef)aURL, callback, &context);
+  }
+
+  auto runLoopSource =
+      CFTypeRefPtr<CFRunLoopSourceRef>::WrapUnderCreateRule(source);
+  CFStringRef mode = CFSTR("ReynardProxyResolution");
+  CFRunLoopAddSource(CFRunLoopGetCurrent(), source, mode);
+
+  CFRunLoopRunInMode(mode, 60, false);
+  CFRunLoopSourceInvalidate(source);
+  return result;
+}
