+nsRect nsDisplayAsyncZoom::GetBounds(nsDisplayListBuilder* aBuilder,
+                                     bool* aSnap) const {
+  nsRect bounds = nsDisplayOwnLayer::GetBounds(aBuilder, aSnap);
+  if (aBuilder->IsForEventDelivery()) {
+    // Bounds are checked before HitTest converts events to layout coordinates.
+    const nsPoint topLeft =
+        ViewportUtils::LayoutToVisual(bounds.TopLeft(), mFrame->PresShell());
+    const nsPoint bottomRight =
+        ViewportUtils::LayoutToVisual(bounds.BottomRight(), mFrame->PresShell());
+    bounds = nsRect(topLeft, nsSize(bottomRight.x - topLeft.x,
+                                   bottomRight.y - topLeft.y));
+  }
+  return bounds;
+}
