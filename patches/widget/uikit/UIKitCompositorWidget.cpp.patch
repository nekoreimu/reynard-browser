+#include "UIKitCompositorWidget.h"
+
+#include <algorithm>
+
+#include "ipc/nsGUIEventIPC.h"
+#include "mozilla/layers/NativeLayer.h"
+#include "mozilla/layers/NativeLayerRootRemoteMacChild.h"
+#include "mozilla/webrender/RenderCompositor.h"
