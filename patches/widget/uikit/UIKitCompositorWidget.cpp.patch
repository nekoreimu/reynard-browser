+namespace mozilla {
+namespace widget {
+
+UIKitCompositorWidget::UIKitCompositorWidget(
+    const layers::CompositorOptions& aOptions)
+    : CompositorWidget(aOptions) {}
+
+UIKitCompositorWidget::~UIKitCompositorWidget() = default;
+
+void UIKitCompositorWidget::Init(CompositorWidgetInitData&& aInitData) {
+  MOZ_ASSERT(XRE_IsGPUProcess());
+
+  CocoaCompositorWidgetInitData cocoaInitData(
+      std::move((aInitData).get_CocoaCompositorWidgetInitData()));
+  mClientSize = cocoaInitData.clientSize();
+  mChildEndpoint = std::move(cocoaInitData.childEndpoint());
+}
+
+mozilla::layers::NativeLayerRoot* UIKitCompositorWidget::GetNativeLayerRoot() {
+  if (!mNativeLayerRoot) {
+    CreateNativeLayerRoot();
+    MOZ_ASSERT(mNativeLayerRoot);
+  }
+  return mNativeLayerRoot;
+}
+
+LayoutDeviceIntSize UIKitCompositorWidget::GetClientSize() {
+  return mClientSize;
+}
+
+void UIKitCompositorWidget::NotifyClientSizeChanged(
+    const LayoutDeviceIntSize& aClientSize) {
+  mClientSize =
+      LayoutDeviceIntSize(std::min(aClientSize.width, MOZ_WIDGET_MAX_SIZE),
+                          std::min(aClientSize.height, MOZ_WIDGET_MAX_SIZE));
+}
+
+void UIKitCompositorWidget::CreateNativeLayerRoot() {
+  MOZ_ASSERT(!NS_IsMainThread());
+  MOZ_ASSERT(XRE_IsGPUProcess());
+
+  auto root = MakeRefPtr<layers::NativeLayerRootRemoteMacChild>();
+  auto remoteChild = root->GetRemoteChild();
+  MOZ_ALWAYS_TRUE(mChildEndpoint.Bind(remoteChild));
+  mNativeLayerRoot = std::move(root);
+}
+
+namespace {
+
+class NativeTextInputScrollNotification final : public wr::NotificationHandler {
+ public:
+  NativeTextInputScrollNotification(
+      wr::WindowId aWindowId,
+      const nsTArray<NativeTextInputScrollUpdate>& aUpdates)
+      : mWindowId(aWindowId) {
+    // Keep the scroll data in the same commit as the rendered layers.
+    IPC::Message message(0, 0, 0);
+    IPC::MessageWriter writer(message);
+    IPC::WriteParam(&writer, aUpdates);
+
+    const auto& buffers = message.Buffers();
+    if (!mData.Allocate(buffers.Size())) {
+      mozalloc_handle_oom(buffers.Size());
+    }
+    auto iter = buffers.Iter();
+    MOZ_ALWAYS_TRUE(buffers.ReadBytes(
+        iter, reinterpret_cast<char*>(mData.mData), mData.mLen));
+  }
+
+  void Notify(wr::Checkpoint aCheckpoint) override {
+    if (aCheckpoint != wr::Checkpoint::FrameTexturesUpdated) {
+      return;
+    }
+
+    auto* renderer = wr::RenderThread::Get()->GetRenderer(mWindowId);
+    if (!renderer) {
+      return;
+    }
+
+    auto* root = renderer->GetCompositor()->GetWidget()->GetNativeLayerRoot();
+    if (!root) {
+      return;
+    }
+
+    root->SetOnscreenCommitData(std::move(mData));
+  }
+
+ private:
+  wr::WindowId mWindowId;
+  mozilla::ipc::ByteBuf mData;
+};
+
+}  // namespace
+
+void AttachNativeTextInputScrollUpdates(
+    wr::WindowId aWindowId, wr::TransactionWrapper& aTransaction,
+    const nsTArray<NativeTextInputScrollUpdate>& aUpdates) {
+  aTransaction.Notify(
+      wr::Checkpoint::FrameTexturesUpdated,
+      MakeUnique<NativeTextInputScrollNotification>(aWindowId, aUpdates));
+}
