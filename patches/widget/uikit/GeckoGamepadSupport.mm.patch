+@interface GeckoGamepadHaptic : NSObject
+- (instancetype)initWithPromise:(GamepadOutputPromise::Private*)promise
+                          owner:(GamepadEventChannelParent*)owner
+                       windowId:(uint64_t)windowId;
+- (void)startWithEngine:(CHHapticEngine*)engine
+              intensity:(double)intensity
+               duration:(double)duration API_AVAILABLE(ios(14.0));
+- (void)finish:(bool)success;
+- (void)stopForOwner:(GamepadEventChannelParent*)owner
+            windowId:(uint64_t)windowId;
+@end
+
+@implementation GeckoGamepadHaptic {
+  CHHapticEngine* mEngine;
+  id<CHHapticAdvancedPatternPlayer> mPlayer;
+  RefPtr<GamepadOutputPromise::Private> mPromise;
+  RefPtr<GamepadEventChannelParent> mOwner;
+  uint64_t mWindowId;
+}
+
+- (instancetype)initWithPromise:(GamepadOutputPromise::Private*)promise
+                          owner:(GamepadEventChannelParent*)owner
+                       windowId:(uint64_t)windowId {
+  self = [super init];
+  if (self) {
+    mPromise = promise;
+    mOwner = owner;
+    mWindowId = windowId;
+  }
+  return self;
+}
+
+- (void)startWithEngine:(CHHapticEngine*)engine
+              intensity:(double)intensity
+               duration:(double)duration {
+  AssertIsOnMainThread();
+  mEngine = [engine retain];
+
+  CHHapticEventParameter* parameter = [[CHHapticEventParameter alloc]
+      initWithParameterID:CHHapticEventParameterIDHapticIntensity
+                    value:intensity];
+  CHHapticEvent* event =
+      [[CHHapticEvent alloc] initWithEventType:CHHapticEventTypeHapticContinuous
+                                    parameters:@[ parameter ]
+                                  relativeTime:0
+                                      duration:GCHapticDurationInfinite];
+  CHHapticPattern* pattern = [[CHHapticPattern alloc] initWithEvents:@[ event ]
+                                                          parameters:@[]
+                                                               error:nil];
+  [event release];
+  [parameter release];
+  if (!pattern) {
+    [self finish:NO];
+    return;
+  }
+
+  mPlayer = [[mEngine createAdvancedPlayerWithPattern:pattern
+                                                error:nil] retain];
+  [pattern release];
+  if (!mPlayer) {
+    [self finish:NO];
+    return;
+  }
+
+  mPlayer.isMuted = intensity == 0;
+  mPlayer.completionHandler = ^(NSError* error) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self finish:error == nil];
+    });
+  };
+  mEngine.stoppedHandler = ^(CHHapticEngineStoppedReason reason) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self finish:NO];
+    });
+  };
+  mEngine.resetHandler = ^{
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self finish:NO];
+    });
+  };
+
+  if (![mEngine startAndReturnError:nil] ||
+      ![mPlayer startAtTime:CHHapticTimeImmediate error:nil] ||
+      ![mPlayer stopAtTime:mEngine.currentTime + duration / 1000.0 error:nil]) {
+    [self finish:NO];
+  }
+}
+
+- (void)finish:(bool)success {
+  AssertIsOnMainThread();
+  if (!mPromise) {
+    return;
+  }
+
+  mPromise->Resolve(success, __func__);
+  mPromise = nullptr;
+  mPlayer.completionHandler = ^(NSError* error) {
+  };
+  mEngine.stoppedHandler = ^(CHHapticEngineStoppedReason reason) {
+  };
+  mEngine.resetHandler = ^{
+  };
+  [mPlayer cancelAndReturnError:nil];
+  [mPlayer release];
+  mPlayer = nil;
+  [mEngine release];
+  mEngine = nil;
+  mOwner = nullptr;
+}
+
+- (void)stopForOwner:(GamepadEventChannelParent*)owner
+            windowId:(uint64_t)windowId {
+  AssertIsOnMainThread();
+  if (mOwner == owner && (!windowId || mWindowId == windowId)) {
+    [self finish:NO];
+  }
+}
+
+@end
+
+namespace {
+
+struct ButtonState {
+  bool mPressed = false;
+  bool mTouched = false;
+  float mValue = 0;
+};
+
+struct HapticState {
+  NSString* mLocality;
+  CHHapticEngine* mEngine = nil;
+  GeckoGamepadHaptic* mHaptic = nil;
+
+  bool EnsureEngine(GCController* aController) API_AVAILABLE(ios(14.0)) {
+    AssertIsOnMainThread();
+    if (!mEngine) {
+      mEngine =
+          [[aController.haptics createEngineWithLocality:mLocality] retain];
+      mEngine.playsHapticsOnly = YES;
+      mEngine.autoShutdownEnabled = YES;
+    }
+    return mEngine != nil;
+  }
+};
+
+class ControllerState final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ControllerState)
+
+  GamepadHandle Handle() {
+    auto handle = mHandle.Lock();
+    return *handle;
+  }
+
+  DataMutex<GamepadHandle> mHandle{"GeckoGamepadSupport::ControllerState"};
+
+  nsTArray<ButtonState> mButtons;
+  nsTArray<bool> mButtonTouches;
+  std::array<float, AXIS_INDEX_COUNT> mAxes{};
+  nsTArray<GamepadTouchState> mTouches;
+  uint32_t mNextTouchId = 0;
+  GamepadPoseState mPose;
+  nsTArray<HapticState> mHaptics;
+
+ private:
+  ~ControllerState() = default;
+};
+
+static nsTArray<GCControllerButtonInput*> ProfileButtons(
+    GCController* aController) {
+  GCExtendedGamepad* gamepad = aController.extendedGamepad;
+  if (!gamepad) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    GCGamepad* basic = aController.gamepad;
+#pragma clang diagnostic pop
+    if (basic) {
+      return {basic.buttonA, basic.buttonB,      basic.buttonX,
+              basic.buttonY, basic.leftShoulder, basic.rightShoulder};
+    }
+    GCMicroGamepad* micro = aController.microGamepad;
+    if (micro) {
+      return {micro.buttonA, micro.buttonX, micro.buttonMenu};
+    }
+    return {};
+  }
+
+  GCControllerButtonInput* home = nil;
+  if (@available(iOS 14.0, *)) {
+    home = gamepad.buttonHome;
+  }
+
+  return {gamepad.buttonA,
+          gamepad.buttonB,
+          gamepad.buttonX,
+          gamepad.buttonY,
+          gamepad.leftShoulder,
+          gamepad.rightShoulder,
+          gamepad.leftTrigger,
+          gamepad.rightTrigger,
+          gamepad.buttonOptions,
+          gamepad.buttonMenu,
+          gamepad.leftThumbstickButton,
+          gamepad.rightThumbstickButton,
+          gamepad.dpad.up,
+          gamepad.dpad.down,
+          gamepad.dpad.left,
+          gamepad.dpad.right,
+          home};
+}
+
+static nsTArray<GCControllerButtonInput*> GamepadButtons(
+    GCController* aController) {
+  auto buttons = ProfileButtons(aController);
+  if (buttons.IsEmpty()) {
+    return buttons;
+  }
+
+  if (@available(iOS 14.0, *)) {
+    NSDictionary<NSString*, GCControllerButtonInput*>* inputs =
+        aController.physicalInputProfile.buttons;
+    for (NSString* name in
+         [[inputs allKeys] sortedArrayUsingSelector:@selector(compare:)]) {
+      GCControllerButtonInput* button = inputs[name];
+      if (![button.collection isKindOfClass:[GCControllerDirectionPad class]] &&
+          !buttons.Contains(button)) {
+        buttons.AppendElement(button);
+      }
+    }
+  }
+
+  return buttons;
+}
+
+static nsTArray<GCControllerDirectionPad*> GamepadTouchpads(
+    GCController* aController) {
+  nsTArray<GCControllerDirectionPad*> touchpads;
+  if (@available(iOS 14.0, *)) {
+    for (NSString* name in
+         @[ GCInputDualShockTouchpadOne, GCInputDualShockTouchpadTwo ]) {
+      GCControllerDirectionPad* touchpad =
+          aController.physicalInputProfile.dpads[name];
+      if (touchpad) {
+        touchpads.AppendElement(touchpad);
+      }
+    }
+  }
+
+  return touchpads;
+}
+
+static nsTArray<GCControllerAxisInput*> GamepadAxes(GCController* aController) {
+  if (GCExtendedGamepad* gamepad = aController.extendedGamepad) {
+    return {gamepad.leftThumbstick.xAxis, gamepad.leftThumbstick.yAxis,
+            gamepad.rightThumbstick.xAxis, gamepad.rightThumbstick.yAxis};
+  }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  GCControllerDirectionPad* dpad = aController.gamepad.dpad;
+#pragma clang diagnostic pop
+  if (!dpad) {
+    dpad = aController.microGamepad.dpad;
+  }
+  if (!dpad) {
+    return {};
+  }
+
+  nsTArray<GCControllerAxisInput*> axes{dpad.xAxis, dpad.yAxis};
+  if (@available(iOS 14.5, *)) {
+    GCControllerDirectionPad* cardinal =
+        aController.physicalInputProfile.dpads[GCInputDirectionalCardinalDpad];
+    if (cardinal && cardinal != dpad) {
+      axes.AppendElement(cardinal.xAxis);
+      axes.AppendElement(cardinal.yAxis);
+    }
+  }
+  return axes;
+}
+
+static float GamepadAxisValue(uint32_t aIndex, float aValue) {
+  if (aIndex == AXIS_INDEX_LEFT_STICK_Y || aIndex == AXIS_INDEX_RIGHT_STICK_Y) {
+    return -aValue;
+  }
+  return aValue;
+}
+
+static GamepadPoseState GamepadMotionState(GCMotion* aMotion,
+                                           GCMotion* aValues) {
+  GamepadPoseState pose;
+  if (!aMotion) {
+    return pose;
+  }
+
+  bool hasAttitude;
+  bool hasRotationRate;
+  bool hasLinearAcceleration = true;
+
+  if (@available(iOS 14.0, *)) {
+    hasAttitude = aMotion.hasAttitude;
+    hasRotationRate = aMotion.hasRotationRate;
+    hasLinearAcceleration = aMotion.hasGravityAndUserAcceleration;
+  } else {
+    hasAttitude = hasRotationRate = aMotion.hasAttitudeAndRotationRate;
+  }
+
+  if (hasAttitude) {
+    pose.flags |= GamepadCapabilityFlags::Cap_Orientation;
+    GCQuaternion attitude = aValues.attitude;
+    double length =
+        std::sqrt(attitude.x * attitude.x + attitude.y * attitude.y +
+                  attitude.z * attitude.z + attitude.w * attitude.w);
+    if (std::isfinite(length) && length > 0) {
+      pose.orientation[0] = attitude.x / length;
+      pose.orientation[1] = attitude.y / length;
+      pose.orientation[2] = attitude.z / length;
+      pose.orientation[3] = attitude.w / length;
+      pose.isOrientationValid = true;
+    }
+  }
+
+  pose.isAngularVelocityValid = Some(hasRotationRate);
+  if (hasRotationRate) {
+    GCRotationRate rotationRate = aValues.rotationRate;
+    pose.angularVelocity[0] = rotationRate.x;
+    pose.angularVelocity[1] = rotationRate.y;
+    pose.angularVelocity[2] = rotationRate.z;
+  }
+
+  pose.isLinearAccelerationValid = Some(hasLinearAcceleration);
+  if (hasLinearAcceleration) {
+    pose.flags |= GamepadCapabilityFlags::Cap_LinearAcceleration;
+    GCAcceleration acceleration = aValues.userAcceleration;
+    constexpr double kMeanGravity = 9.80665;
+    pose.linearAcceleration[0] = acceleration.x * kMeanGravity;
+    pose.linearAcceleration[1] = acceleration.y * kMeanGravity;
+    pose.linearAcceleration[2] = acceleration.z * kMeanGravity;
+  }
+  return pose;
+}
+
+static void SetMotionActive(GCMotion* aMotion, bool aActive) {
+  if (@available(iOS 14.0, *)) {
+    if (aMotion.sensorsRequireManualActivation) {
+      aMotion.sensorsActive = aActive;
+    }
+  }
+}
+
+}  // namespace
