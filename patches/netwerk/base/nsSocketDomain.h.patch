+
+#ifndef nsSocketDomain_h_
+#define nsSocketDomain_h_
+
+#include "mozilla/net/DNS.h"
+#include "nsString.h"
+
+extern "C" {
+#include <networkext/ne_socket.h>
+}
+
+namespace mozilla {
+namespace net {
+
+inline int SetSocketDomain(int aSocket, const nsACString& aHost) {
+  if (__builtin_available(iOS 15.0, *)) {
+    NetAddr address;
+    if (NS_FAILED(address.InitFromString(aHost))) {
+      const auto& host = PromiseFlatCString(aHost);
+      const char* domains[] = {host.get()};
+      return ne_socket_set_domains(aSocket, domains, 1);
+    }
+  }
+
+  return 0;
+}
+
+}  // namespace net
+}  // namespace mozilla
+
+#endif  // nsSocketDomain_h_
